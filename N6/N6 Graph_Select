import tkinter as tk
from tkinter import ttk, filedialog, messagebox
import pandas as pd
import matplotlib.pyplot as plt
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg, NavigationToolbar2Tk

class ApplicationGraficos:
    def __init__(self, root):
        self.root = root
        self.root.title("Visualizador e Gerador de Gráficos")
        self.root.geometry("1000x700")

        self.df = None
        self.fig, self.ax = plt.subplots(figsize=(8, 5))

        self.criar_interface()

    def criar_interface(self):
        # Frame Superior - Controles
        control_frame = ttk.LabelFrame(self.root, text=" Configurações e Arquivo ", padding=10)
        control_frame.pack(side=tk.TOP, fill=tk.X, padx=10, pady=10)

        # Botão de Carregar Arquivo
        btn_load = ttk.Button(control_frame, text="📁 Abrir Arquivo", command=self.carregar_arquivo)
        btn_load.grid(row=0, column=0, padx=5, pady=5)

        self.lbl_file = ttk.Label(control_frame, text="Nenhum arquivo selecionado", font=("Arial", 9, "italic"))
        self.lbl_file.grid(row=0, column=1, columnspan=4, padx=5, pady=5, sticky="w")

        # Seleção Eixo X
        ttk.Label(control_frame, text="Eixo X:").grid(row=1, column=0, padx=5, pady=5, sticky="e")
        self.combo_x = ttk.Combobox(control_frame, state="readonly", width=18)
        self.combo_x.grid(row=1, column=1, padx=5, pady=5)

        # Seleção Eixo Y
        ttk.Label(control_frame, text="Eixo Y:").grid(row=1, column=2, padx=5, pady=5, sticky="e")
        self.combo_y = ttk.Combobox(control_frame, state="readonly", width=18)
        self.combo_y.grid(row=1, column=3, padx=5, pady=5)

        # Botões de Ação
        btn_plot = ttk.Button(control_frame, text="📈 Gerar Gráfico", command=self.gerar_grafico)
        btn_plot.grid(row=1, column=4, padx=5, pady=5)

        btn_save = ttk.Button(control_frame, text="💾 Salvar Imagem", command=self.salvar_grafico)
        btn_save.grid(row=1, column=5, padx=5, pady=5)

        # Frame Inferior - Exibição do Gráfico
        self.plot_frame = ttk.Frame(self.root)
        self.plot_frame.pack(side=tk.BOTTOM, fill=tk.BOTH, expand=True, padx=10, pady=10)

        # Canvas do Matplotlib integrado ao Tkinter
        self.canvas = FigureCanvasTkAgg(self.fig, master=self.plot_frame)
        self.canvas.get_tk_widget().pack(side=tk.TOP, fill=tk.BOTH, expand=True)

        # Barra de ferramentas nativa do Matplotlib (zoom, pan, etc.)
        self.toolbar = NavigationToolbar2Tk(self.canvas, self.plot_frame)
        self.toolbar.update()

    def carregar_arquivo(self):
        file_path = filedialog.askopenfilename(
            title="Selecione o arquivo de dados",
            filetypes=[("Arquivos Texto/CSV", "*.txt *.csv"), ("Todos os arquivos", "*.*")]
        )
        
        if file_path:
            try:
                # Leitura mantendo a estrutura do separador ';' do TXT
                self.df = pd.read_csv(file_path, sep=';')
                
                # Trata automaticamente a coluna de data/hora se existir
                if 'Time stamp' in self.df.columns:
                    self.df['Time stamp'] = pd.to_datetime(
                        self.df['Time stamp'], 
                        format='%d/%m/%Y %H:%M:%S', 
                        errors='coerce'
                    )

                # Atualiza as opções dos menus suspensos (Eixos X e Y)
                colunas = list(self.df.columns)
                self.combo_x['values'] = colunas
                self.combo_y['values'] = colunas

                # Predefinição dos eixos
                if len(colunas) > 0:
                    self.combo_x.current(0)  # Padrão: Time stamp
                if len(colunas) > 2:
                    self.combo_y.current(2)  # Padrão: RSSI_DL

                nome_arquivo = file_path.split('/')[-1]
                self.lbl_file.config(text=f"Arquivo: {nome_arquivo}", font=("Arial", 9, "bold"))
                messagebox.showinfo("Sucesso", f"Arquivo '{nome_arquivo}' carregado com sucesso!")

            except Exception as e:
                messagebox.showerror("Erro de Leitura", f"Falha ao processar o arquivo:\n{e}")

    def gerar_grafico(self):
        if self.df is None:
            messagebox.showwarning("Atenção", "Carregue um arquivo TXT antes de gerar o gráfico.")
            return

        eixo_x = self.combo_x.get()
        eixo_y = self.combo_y.get()

        if not eixo_x or not eixo_y:
            messagebox.showwarning("Atenção", "Selecione as colunas para o Eixo X e Eixo Y.")
            return

        # Limpa o gráfico anterior
        self.ax.clear()

        # Plota os novos dados
        self.ax.plot(self.df[eixo_x], self.df[eixo_y], color='#1f77b4', linewidth=1.5, label=eixo_y)

        # Personalização do gráfico
        self.ax.set_xlabel(eixo_x, fontsize=10, fontweight='bold')
        self.ax.set_ylabel(eixo_y, fontsize=10, fontweight='bold')
        self.ax.set_title(f"Gráfico de {eixo_y} vs {eixo_x}", fontsize=12, fontweight='bold')
        self.ax.grid(True, linestyle='--', alpha=0.6)
        self.ax.legend(loc='best')

        # Ajusta a formatação das datas no Eixo X caso seja a coluna Time stamp
        if pd.api.types.is_datetime64_any_dtype(self.df[eixo_x]):
            self.fig.autofmt_xdate()

        self.fig.tight_layout()
        self.canvas.draw()

    def salvar_grafico(self):
        if self.df is None:
            messagebox.showwarning("Atenção", "Gere um gráfico antes de tentar salvar.")
            return

        file_path = filedialog.asksaveasfilename(
            defaultextension=".png",
            filetypes=[
                ("Imagem PNG", "*.png"),
                ("Imagem JPEG", "*.jpg"),
                ("Documento PDF", "*.pdf"),
                ("Vetor SVG", "*.svg")
            ],
            title="Salvar Gráfico Como"
        )
        
        if file_path:
            try:
                self.fig.savefig(file_path, dpi=300)
                messagebox.showinfo("Sucesso", f"Gráfico salvo com sucesso em:\n{file_path}")
            except Exception as e:
                messagebox.showerror("Erro ao Salvar", f"Não foi possível salvar a imagem:\n{e}")

if __name__ == "__main__":
    root = tk.Tk()
    app = ApplicationGraficos(root)
    root.mainloop()